*Program 1: Shopping Bill*
#include <iostream>
using namespace std;

int main() {
    int n_qty, p_qty;
    float n_price, p_price, total;
    
    cout << "Enter Notebook Price: ";
    cin >> n_price;
    cout << "Enter Notebook Quantity: ";
    cin >> n_qty;
    
    cout << "Enter Pen Price: ";
    cin >> p_price;
    cout << "Enter Pen Quantity: ";
    cin >> p_qty;
    
    total = (n_price * n_qty) + (p_price * p_qty);
    
    cout << "Total Shopping Bill = Rs. " << total << endl;
    return 0;
}
