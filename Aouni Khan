*Program 5: Petrol Expense Calculator*
#include <iostream>
using namespace std;

int main() {
    float distance, avg, price;
    float fuel, cost;
    
    cout << "Enter Distance Travelled (km): ";
    cin >> distance;
    cout << "Enter Average km per litre: ";
    cin >> avg;
    cout << "Enter Petrol Price per litre: ";
    cin >> price;
    
    fuel = distance / avg;
    cost = fuel * price;
    
    cout << "Fuel Consumed = " << fuel << " litres" << endl;
    cout << "Total Fuel Cost = Rs. " << cost << endl;
    return 0;
}
